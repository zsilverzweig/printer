{
  "name": "printer",
  "version": "1.0.0",
  "description": "An AI-powered investment research engine that produces actionable, company-level investment theses through structured reasoning and adversarial testing.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "nx run-many --target=dev --projects=web,server --parallel",
    "dev:web": "nx dev web",
    "dev:server": "nx dev server",
    "build": "nx run-many --target=build --all",
    "build:web": "nx build web",
    "build:shared": "nx type-check shared",
    "start": "nx start web",
    "start:web": "nx start web",
    "start:server": "nx start server",
    "lint": "nx run-many --target=lint --all",
    "lint:web": "nx lint web",
    "lint:fix": "cd apps/web && next lint --fix",
    "type-check": "nx run-many --target=type-check --all",
    "type-check:web": "nx type-check web",
    "type-check:shared": "nx type-check shared",
    "test": "nx test web",
    "test:watch": "nx test web --watch",
    "test:coverage": "nx test web --coverage",
    "test:python": "cd apps/server && python3 -m pytest",
    "test:python:watch": "cd apps/server && python3 -m pytest --watch",
    "test:python:coverage": "cd apps/server && python3 -m pytest --cov=app --cov-report=html",
    "prepare": "cd apps/web && next-ws patch",
    "nx": "nx"
  },
  "dependencies": {
    "@polygon.io/client-js": "^8.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.12.0",
    "@stripe/stripe-js": "^7.9.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "firebase": "^12.2.1",
    "gray-matter": "^4.0.3",
    "lightweight-charts": "4.2.3",
    "lodash": "^4.17.21",
    "lucide-react": "^0.544.0",
    "next": "^14.0.0",
    "next-ws": "^2.1.5",
    "openai": "^5.20.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-hotkeys-hook": "5.2.1",
    "remark": "^15.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "sonner": "^2.0.7",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@nx/js": "^22.0.1",
    "@nx/next": "^22.0.1",
    "@nx/workspace": "^22.0.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.20",
    "@types/node": "20.19.17",
    "@types/react": "18.3.24",
    "@types/react-dom": "^18.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "autoprefixer": "^10.0.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nx": "22.0.1",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.0.0",
    "ts-jest": "^29.1.2",
    "typescript": "5.9.2"
  },
  "directories": {
    "doc": "docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "nx": {}
}
