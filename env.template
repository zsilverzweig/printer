# Printer Monorepo Environment Configuration Template
# Copy this file to .env.local and fill in your actual values
# Note: Some variables are prefixed with WEB_ or SERVER_ to indicate which app uses them

# ============================================================================
# WEB APP CONFIGURATION (Next.js)
# ============================================================================

# Firebase Configuration
# Get these values from your Firebase project settings
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# OpenAI Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Polygon.io Configuration
# Get your API key from https://polygon.io
NEXT_PUBLIC_POLY_API_KEY=your_polygon_api_key_here
POLY_API_KEY=your_server_side_polygon_api_key_here

# Sentry Configuration
# Get your DSN from https://sentry.io/settings/[org]/projects/[project]/keys/
NEXT_PUBLIC_SENTRY_DSN=sentry_dsn
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# Stripe Configuration
# Get these values from your Stripe dashboard at https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Alpaca OAuth2 Configuration (for web app user account linking)
# Get these from: https://alpaca.markets/apps
ALPACA_CLIENT_ID=your_alpaca_client_id_here
ALPACA_CLIENT_SECRET=your_alpaca_client_secret_here
ALPACA_AUTH_URL=https://app.alpaca.markets/oauth/authorize
ALPACA_TOKEN_URL=https://api.alpaca.markets/oauth/token
ALPACA_API_BASE_URL=https://api.alpaca.markets
ALPACA_PAPER_API_BASE_URL=https://paper-api.alpaca.markets

# Application URLs
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# FastAPI Server Connection (from web app)
NEXT_PUBLIC_MARKET_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MARKET_WS_URL=ws://localhost:8000/ws

# Security Configuration
JWT_SECRET=your_jwt_secret_here
ADMIN_API_KEY=your_admin_api_key_here

# Cost Monitoring Configuration
DAILY_COST_LIMIT=50
HOURLY_COST_LIMIT=10
PER_REQUEST_COST_LIMIT=5

# Rate Limiting Configuration
DEFAULT_RATE_LIMIT=10
COMPANY_RESEARCH_RATE_LIMIT=3
TRADE_ANALYSIS_RATE_LIMIT=5
PATTERN_MATCHING_RATE_LIMIT=8

# Development Configuration
NEXT_PUBLIC_LOG_LEVEL=DEBUG
ENABLE_COST_ALERTS=true
CACHE_TTL=3600

# ============================================================================
# SERVER APP CONFIGURATION (FastAPI/Python)
# ============================================================================

# OpenAI Configuration (server-side)
# Same key as above, or use a different one for server operations
# OPENAI_API_KEY=your_openai_api_key_here

# Polygon API Configuration (server-side)
POLYGON_API_KEY=your_polygon_api_key_here

# Alpaca Paper Trading Configuration (server-side AI trading)
# Get your paper trading credentials from: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here

# Database Configuration
# PostgreSQL connection string for event tracking
DATABASE_URL=postgresql+asyncpg://localhost:5432/printer_events

# FastAPI Server Configuration
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ============================================================================
# FUTURE CONFIGURATION
# ============================================================================

