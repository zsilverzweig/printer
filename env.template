# Printer Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

# ============================================================================
# FIREBASE CONFIGURATION
# ============================================================================
# Get these values from your Firebase project settings
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# ============================================================================
# OPENAI CONFIGURATION
# ============================================================================
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# SENTRY CONFIGURATION
# ============================================================================
# Get your DSN from https://sentry.io/settings/[org]/projects/[project]/keys/
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Sentry auth token for uploading source maps (get from https://sentry.io/settings/auth-tokens/)
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Application environment
NODE_ENV=development

# Application URL (for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# JWT Secret for session management (generate a random string)
JWT_SECRET=your_jwt_secret_here

# API Key for admin operations (generate a random string)
ADMIN_API_KEY=your_admin_api_key_here

# ============================================================================
# COST MONITORING CONFIGURATION
# ============================================================================
# Daily cost limit in USD
DAILY_COST_LIMIT=50

# Hourly cost limit in USD
HOURLY_COST_LIMIT=10

# Per-request cost limit in USD
PER_REQUEST_COST_LIMIT=5

# ============================================================================
# RATE LIMITING CONFIGURATION
# ============================================================================
# Default rate limit (requests per minute)
DEFAULT_RATE_LIMIT=10

# Company research rate limit (requests per minute)
COMPANY_RESEARCH_RATE_LIMIT=3

# Trade analysis rate limit (requests per minute)
TRADE_ANALYSIS_RATE_LIMIT=5

# Pattern matching rate limit (requests per minute)
PATTERN_MATCHING_RATE_LIMIT=8

# ============================================================================
# VECTOR DATABASE CONFIGURATION (Future)
# ============================================================================
# Pinecone configuration (when implemented)
# PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_ENVIRONMENT=your_pinecone_environment_here
# PINECONE_INDEX_NAME=printer-vectors

# ============================================================================
# MONITORING & ALERTING (Future)
# ============================================================================
# Slack webhook for alerts (when implemented)
# SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# Email configuration for alerts (when implemented)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password_here

# ============================================================================
# DEVELOPMENT CONFIGURATION
# ============================================================================


# Log level for the application (DEBUG, INFO, WARN, ERROR)
# In production, only ERROR level logs should be shown
# Note: NEXT_PUBLIC_ prefix is required for client-side access
NEXT_PUBLIC_LOG_LEVEL=DEBUG

# Enable cost monitoring alerts in development
ENABLE_COST_ALERTS=true

# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL=3600
