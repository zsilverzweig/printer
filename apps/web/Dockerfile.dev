FROM node:20-alpine

# Install dependencies for node-gyp and other native modules
RUN apk add --no-cache python3 make g++

# Set working directory
WORKDIR /app

# Copy package files for dependency installation
COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/

# Copy apps/web package.json (needed for prepare script)
COPY apps/web/package*.json ./apps/web/
COPY apps/web/next.config.js ./apps/web/

# Install dependencies
RUN npm install

# Install Rollup for Alpine Linux (musl) - fixes optional dependency issue
RUN npm install @rollup/rollup-linux-x64-musl --save-optional || true

# Copy the rest of the application
COPY . .

# Expose Next.js port
EXPOSE 3000

# Start development server (command specified in docker-compose.yml)

