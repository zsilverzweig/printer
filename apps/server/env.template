# Copy this to env.local and fill in your values

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Polygon - https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=

# Alpaca Paper Trading - https://app.alpaca.markets/paper/dashboard/overview
# These credentials are used for funds with mode="sim"
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Alpaca Real Trading - https://app.alpaca.markets/brokerage/dashboard/overview
# IMPORTANT: Only set these if you intend to enable real trading
# These credentials are used for funds with mode="real"
# Leave blank to disable real trading (safer default)
ALPACA_REAL_API_KEY=
ALPACA_REAL_SECRET_KEY=

# Database (use 'db' for Docker, 'localhost' for local)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/printer_events

# Market Data Services
# Enable real-time ingestion from Polygon WebSocket (AM.* subscription)
MARKET_DATA_INGESTION_ENABLED=false

# Enable automatic backfill of missing/incomplete data
MARKET_DATA_BACKFILL_ENABLED=false

# How many days of historical data to maintain (default: 30)
# Set to 365 for 1 year, 730 for 2 years, etc.
MARKET_DATA_LOOKBACK_DAYS=30

# Health check interval (seconds)
MARKET_DATA_HEALTH_CHECK_INTERVAL=300

# Server config
DEBUG=True
HOST=0.0.0.0
PORT=8000
